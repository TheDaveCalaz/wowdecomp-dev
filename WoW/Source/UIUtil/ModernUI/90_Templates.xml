<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<!-- ModernUI: built into the client (not in the original 3.3.5a).
	     Frame templates modern addons inherit from, made of 3.3.5 parts. -->

	<!-- Backdrops are built into every 3.3.5 frame; the template only has to exist. -->
	<Frame name="BackdropTemplate" virtual="true"/>

	<Frame name="TooltipBackdropTemplate" virtual="true">
		<Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
			<EdgeSize><AbsValue val="16"/></EdgeSize>
			<TileSize><AbsValue val="16"/></TileSize>
			<BackgroundInsets><AbsInset left="5" right="5" top="5" bottom="5"/></BackgroundInsets>
		</Backdrop>
		<Scripts>
			<OnLoad>
				self:SetBackdropColor(0, 0, 0, 0.9)
			</OnLoad>
		</Scripts>
	</Frame>

	<Frame name="TooltipBorderedFrameTemplate" inherits="TooltipBackdropTemplate" virtual="true"/>

	<!-- Help boxes: dark panel with a gold edge and an arrow. -->
	<Frame name="GlowBoxTemplate" virtual="true" frameStrata="DIALOG">
		<Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
			<EdgeSize><AbsValue val="16"/></EdgeSize>
			<TileSize><AbsValue val="16"/></TileSize>
			<BackgroundInsets><AbsInset left="4" right="4" top="4" bottom="4"/></BackgroundInsets>
		</Backdrop>
		<Scripts>
			<OnLoad>
				self:SetBackdropColor(0, 0, 0, 0.85)
				self:SetBackdropBorderColor(1, 0.82, 0, 1)
			</OnLoad>
		</Scripts>
	</Frame>

	<Frame name="GlowBoxArrowTemplate" virtual="true">
		<Size><AbsDimension x="21" y="16"/></Size>
		<Layers>
			<Layer level="ARTWORK">
				<Texture name="$parentArrow" parentKey="Arrow" file="Interface\Buttons\UI-ScrollBar-ScrollDownButton-Up" setAllPoints="true"/>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad>
				self.Glow = self.Arrow
			</OnLoad>
		</Scripts>
	</Frame>

	<!-- Drag bar: drags its parent. -->
	<Frame name="PanelDragBarTemplate" virtual="true" enableMouse="true">
		<Scripts>
			<OnMouseDown>
				local parent = self:GetParent()
				if parent:IsMovable() then
					parent:StartMoving()
				end
			</OnMouseDown>
			<OnMouseUp>
				self:GetParent():StopMovingOrSizing()
			</OnMouseUp>
		</Scripts>
	</Frame>

	<!-- Resize grip in a frame's corner. -->
	<Button name="PanelResizeButtonTemplate" virtual="true">
		<Size><AbsDimension x="16" y="16"/></Size>
		<NormalTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Up"/>
		<HighlightTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Highlight"/>
		<PushedTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Down"/>
		<Scripts>
			<OnMouseDown>
				local parent = self:GetParent()
				if parent:IsResizable() then
					parent:StartSizing("BOTTOMRIGHT")
				end
			</OnMouseDown>
			<OnMouseUp>
				self:GetParent():StopMovingOrSizing()
			</OnMouseUp>
		</Scripts>
	</Button>

	<!-- Window with a dialog border, a portrait, a title and a close button. The parts carry the modern
	     keys (Bg, TitleBg, TitleContainer, TitleText, portrait, PortraitContainer, CloseButton) and the
	     methods come from PortraitFrameMixin, so they survive a frame that replaces OnLoad. -->
	<Frame name="PortraitFrameTemplate" virtual="true" toplevel="true" enableMouse="true" mixin="PortraitFrameMixin">
		<Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
			<EdgeSize><AbsValue val="32"/></EdgeSize>
			<TileSize><AbsValue val="32"/></TileSize>
			<BackgroundInsets><AbsInset left="11" right="12" top="12" bottom="11"/></BackgroundInsets>
		</Backdrop>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentBg" parentKey="Bg">
					<Anchors>
						<Anchor point="TOPLEFT"><Offset><AbsDimension x="11" y="-12"/></Offset></Anchor>
						<Anchor point="BOTTOMRIGHT"><Offset><AbsDimension x="-12" y="11"/></Offset></Anchor>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="BORDER">
				<Texture name="$parentTitleBg" parentKey="TitleBg">
					<Size><AbsDimension x="0" y="20"/></Size>
					<Anchors>
						<Anchor point="TOPLEFT"><Offset><AbsDimension x="11" y="-12"/></Offset></Anchor>
						<Anchor point="TOPRIGHT"><Offset><AbsDimension x="-12" y="-12"/></Offset></Anchor>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<Texture name="$parentPortrait" parentKey="portrait">
					<Size><AbsDimension x="58" y="58"/></Size>
					<Anchors>
						<Anchor point="TOPLEFT"><Offset><AbsDimension x="-6" y="7"/></Offset></Anchor>
					</Anchors>
				</Texture>
				<FontString name="$parentTitleText" parentKey="TitleText" inherits="GameFontNormal">
					<Anchors>
						<Anchor point="TOP"><Offset><AbsDimension x="0" y="-16"/></Offset></Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Frame name="$parentTitleContainer" parentKey="TitleContainer">
				<Size><AbsDimension x="0" y="20"/></Size>
				<Anchors>
					<Anchor point="TOPLEFT"><Offset><AbsDimension x="58" y="-12"/></Offset></Anchor>
					<Anchor point="TOPRIGHT"><Offset><AbsDimension x="-30" y="-12"/></Offset></Anchor>
				</Anchors>
			</Frame>
			<Button name="$parentCloseButton" parentKey="CloseButton" inherits="UIPanelCloseButton">
				<Anchors>
					<Anchor point="TOPRIGHT"><Offset><AbsDimension x="-3" y="-3"/></Offset></Anchor>
				</Anchors>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad>
				self.PortraitContainer = self.PortraitContainer or ModernUI_PortraitContainer(self.portrait)
				if self.TitleContainer then
					self.TitleContainer.TitleText = self.TitleText
				end
			</OnLoad>
		</Scripts>
	</Frame>

	<Frame name="ButtonFrameTemplate" inherits="PortraitFrameTemplate" virtual="true">
		<Frames>
			<Frame name="$parentInset" parentKey="Inset" inherits="InsetFrameTemplate">
				<Anchors>
					<Anchor point="TOPLEFT"><Offset><AbsDimension x="14" y="-60"/></Offset></Anchor>
					<Anchor point="BOTTOMRIGHT"><Offset><AbsDimension x="-14" y="26"/></Offset></Anchor>
				</Anchors>
			</Frame>
		</Frames>
	</Frame>
	<Frame name="PortraitFrameTexturedBaseTemplate" inherits="PortraitFrameTemplate" virtual="true"/>
	<Frame name="ButtonFrameTemplateMinimizable" inherits="ButtonFrameTemplate" virtual="true"/>
	<Frame name="DefaultPanelTemplate" inherits="PortraitFrameTemplate" virtual="true">
		<Scripts>
			<OnLoad>
				self.portrait:Hide()
				self.PortraitContainer = ModernUI_PortraitContainer(self.portrait)
				if self.TitleContainer then
					self.TitleContainer.TitleText = self.TitleText
				end
			</OnLoad>
		</Scripts>
	</Frame>
	<Frame name="DefaultPanelFlatTemplate" inherits="DefaultPanelTemplate" virtual="true"/>
	<Frame name="DefaultPanelBaseTemplate" inherits="DefaultPanelTemplate" virtual="true"/>
	<Frame name="BasicFrameTemplate" inherits="DefaultPanelTemplate" virtual="true"/>
	<Frame name="BasicFrameTemplateWithInset" inherits="DefaultPanelTemplate" virtual="true"/>

	<Frame name="InsetFrameTemplate" virtual="true">
		<Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
			<EdgeSize><AbsValue val="12"/></EdgeSize>
			<TileSize><AbsValue val="16"/></TileSize>
			<BackgroundInsets><AbsInset left="3" right="3" top="3" bottom="3"/></BackgroundInsets>
		</Backdrop>
		<Scripts>
			<OnLoad>
				self:SetBackdropColor(0, 0, 0, 0.5)
				self:SetBackdropBorderColor(0.6, 0.6, 0.6, 1)
			</OnLoad>
		</Scripts>
	</Frame>

	<!-- A scroll frame with the 3.3.5 scroll bar. -->
	<ScrollFrame name="ScrollFrameTemplate" inherits="UIPanelScrollFrameTemplate" virtual="true"/>
	<!-- Dialog borders. -->
	<Frame name="DialogBorderTemplate" virtual="true" setAllPoints="true">
		<Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
			<EdgeSize><AbsValue val="32"/></EdgeSize>
			<TileSize><AbsValue val="32"/></TileSize>
			<BackgroundInsets><AbsInset left="11" right="12" top="12" bottom="11"/></BackgroundInsets>
		</Backdrop>
	</Frame>
	<Frame name="DialogBorderDarkTemplate" virtual="true" setAllPoints="true">
		<Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background-Dark" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
			<EdgeSize><AbsValue val="32"/></EdgeSize>
			<TileSize><AbsValue val="32"/></TileSize>
			<BackgroundInsets><AbsInset left="11" right="12" top="12" bottom="11"/></BackgroundInsets>
		</Backdrop>
	</Frame>
	<Frame name="DialogBorderOpaqueTemplate" virtual="true" setAllPoints="true">
		<Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background-Dark" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
			<EdgeSize><AbsValue val="32"/></EdgeSize>
			<TileSize><AbsValue val="32"/></TileSize>
			<BackgroundInsets><AbsInset left="11" right="12" top="12" bottom="11"/></BackgroundInsets>
		</Backdrop>
		<Scripts>
			<OnLoad>
				self:SetBackdropColor(0, 0, 0, 1)
			</OnLoad>
		</Scripts>
	</Frame>
	<Frame name="DialogBorderTranslucentTemplate" inherits="DialogBorderTemplate" virtual="true"/>
	<Frame name="DialogBorderNoCenterTemplate" virtual="true" setAllPoints="true">
		<Backdrop edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
			<EdgeSize><AbsValue val="32"/></EdgeSize>
		</Backdrop>
	</Frame>

	<!-- A plain stretchable button. -->
	<Button name="UIMenuButtonStretchTemplate" inherits="UIPanelButtonTemplate" virtual="true"/>

	<!-- Nine-slice frames: a backdrop the modern NineSlice layouts are applied to. -->
	<Frame name="NineSliceCodeTemplate" virtual="true" mixin="NineSlicePanelMixin">
		<Scripts>
			<OnLoad>
				if self.layoutType and NineSliceUtil then
					NineSliceUtil.ApplyLayoutByName(self, self.layoutType)
				end
			</OnLoad>
		</Scripts>
	</Frame>
	<Frame name="NineSlicePanelTemplate" inherits="NineSliceCodeTemplate" virtual="true"/>

	<!-- Minimise / maximise button pair (the methods come from MaximizeMinimizeButtonFrameMixin). -->
	<Frame name="MaximizeMinimizeButtonFrameTemplate" virtual="true" mixin="MaximizeMinimizeButtonFrameMixin">
		<Size><AbsDimension x="32" y="32"/></Size>
		<Frames>
			<Button name="$parentMaximizeButton" parentKey="MaximizeButton" hidden="true">
				<Size><AbsDimension x="32" y="32"/></Size>
				<Anchors><Anchor point="CENTER"/></Anchors>
				<NormalTexture file="Interface\Buttons\UI-Panel-BiggerButton-Up"/>
				<PushedTexture file="Interface\Buttons\UI-Panel-BiggerButton-Down"/>
				<HighlightTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Highlight" alphaMode="ADD"/>
				<Scripts>
					<OnClick>
						PlaySound("igMainMenuOptionCheckBoxOn")
						self:GetParent():Maximize()
					</OnClick>
				</Scripts>
			</Button>
			<Button name="$parentMinimizeButton" parentKey="MinimizeButton">
				<Size><AbsDimension x="32" y="32"/></Size>
				<Anchors><Anchor point="CENTER"/></Anchors>
				<NormalTexture file="Interface\Buttons\UI-Panel-SmallerButton-Up"/>
				<PushedTexture file="Interface\Buttons\UI-Panel-SmallerButton-Down"/>
				<HighlightTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Highlight" alphaMode="ADD"/>
				<Scripts>
					<OnClick>
						PlaySound("igMainMenuOptionCheckBoxOn")
						self:GetParent():Minimize()
					</OnClick>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnShow>
				if self.isMinimized then self:SetMinimizedLook() else self:SetMaximizedLook() end
			</OnShow>
		</Scripts>
	</Frame>

	<!-- Close button variants. -->
	<Button name="UIPanelCloseButtonNoScripts" inherits="UIPanelCloseButton" virtual="true"/>
	<Button name="UIPanelCloseButtonDefaultAnchors" inherits="UIPanelCloseButton" virtual="true">
		<Anchors>
			<Anchor point="TOPRIGHT"><Offset><AbsDimension x="-3" y="-3"/></Offset></Anchor>
		</Anchors>
	</Button>
	<Button name="UIPanelButtonNoTooltipTemplate" inherits="UIPanelButtonTemplate" virtual="true"/>

	<!-- Search box: an input box with a grey "Search" hint and a clear button. -->
	<EditBox name="SearchBoxTemplate" inherits="InputBoxTemplate" autoFocus="false" virtual="true">
		<Size><AbsDimension x="150" y="20"/></Size>
		<Layers>
			<Layer level="OVERLAY">
				<FontString name="$parentInstructions" parentKey="Instructions" inherits="GameFontDisableSmall" text="SEARCH" justifyH="LEFT">
					<Anchors>
						<Anchor point="LEFT"><Offset><AbsDimension x="2" y="0"/></Offset></Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Button name="$parentClearButton" parentKey="clearButton" hidden="true">
				<Size><AbsDimension x="14" y="14"/></Size>
				<Anchors>
					<Anchor point="RIGHT"><Offset><AbsDimension x="-3" y="0"/></Offset></Anchor>
				</Anchors>
				<NormalTexture file="Interface\FriendsFrame\ClearBroadcastIcon"/>
				<Scripts>
					<OnClick>
						SearchBoxTemplateClearButton_OnClick(self)
					</OnClick>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnEscapePressed>
				self:ClearFocus()
			</OnEscapePressed>
			<OnTextChanged>
				SearchBoxTemplate_OnTextChanged(self)
			</OnTextChanged>
			<OnEditFocusGained>
				if self.Instructions then self.Instructions:Hide() end
			</OnEditFocusGained>
			<OnEditFocusLost>
				SearchBoxTemplate_OnTextChanged(self)
			</OnEditFocusLost>
		</Scripts>
	</EditBox>
	<EditBox name="BagSearchBoxTemplate" inherits="SearchBoxTemplate" virtual="true"/>

	<!-- Texture templates modern code creates textures from. -->
	<Texture name="_UI-Frame-TitleTileBg" virtual="true">
		<Color r="0.08" g="0.08" b="0.08" a="0.9"/>
	</Texture>
	<Texture name="UI-Frame-TitleTileBg" inherits="_UI-Frame-TitleTileBg" virtual="true"/>
	<Texture name="UIPanelButtonUpTexture" file="Interface\Buttons\UI-Panel-Button-Up" virtual="true">
